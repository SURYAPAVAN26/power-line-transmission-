# ── Insulator Defect Detection API — environment variables ──────────────────
# Copy this file to .env and adjust values before starting the server.

# Path to the trained YOLOv8 weights file (relative to project root or absolute)
MODEL_PATH=models/best.pt

# Optional: Direct URL to download weights from (HuggingFace / GitHub release / S3) if not present locally
# MODEL_URL=https://github.com/your-username/your-repo/releases/download/v1.0.0/best.pt

# Confidence threshold for detections (0.0 – 1.0)
CONFIDENCE_THRESHOLD=0.25

# Host and port for Uvicorn
HOST=0.0.0.0
PORT=8000

# Log level: debug | info | warning | error
LOG_LEVEL=info
